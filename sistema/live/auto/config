#!/bin/sh
# Configuração do live-build para a imagem Brisa (base Debian 13 "trixie").
set -e

lb config noauto \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --binary-images iso-hybrid \
  --debian-installer none \
  --apt-recommends false \
  --firmware-chroot false \
  --firmware-binary false \
  --memtest none \
  --linux-flavours amd64 \
  --image-name brisa \
  --iso-application "Brisa" \
  --iso-volume "BRISA_1_0" \
  --iso-publisher "Projeto Brisa" \
  --bootappend-live "boot=live components quiet locales=pt_PT.UTF-8 keyboard-layouts=pt username=brisa hostname=brisa user-fullname=Brisa timezone=Europe/Lisbon" \
  "${@}"
