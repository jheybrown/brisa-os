#!/usr/bin/env python3
"""Loja do Brisa: um catálogo escolhido de aplicações, instaladas com um clique.

As aplicações vêm do Flathub e são instaladas na conta do utilizador, por isso
não é precisa palavra-passe de administrador. Os textos seguem o idioma da sessão.
"""
import os
import shutil
import subprocess
import threading

import gi

gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('Flatpak', '1.0')
from gi.repository import Flatpak, Gdk, Gio, GLib, Gtk  # noqa: E402

FLATHUB = 'https://dl.flathub.org/repo/flathub.flatpakrepo'
PT = os.environ.get('LANG', 'pt').lower().startswith('pt')


def t(pt, en):
    return pt if PT else en


# (identificador no Flathub, nome, descrição PT, descrição EN, categoria, cor)
CATALOGO = [
    ('com.google.Chrome', 'Google Chrome', 'Navegador da Google', 'Web browser by Google', 'internet', '#E8453C'),
